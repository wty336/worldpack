# DeepSeek API（https://platform.deepseek.com/ 申请）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenAI 兼容端点（默认官方地址，可换任何兼容代理）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek V4 系列模型（deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用）
# deepseek-v4-flash：快速便宜，适合日常对话与剧情生成（默认）
# deepseek-v4-pro：更强，适合关键节点与复杂剧情（更慢更贵）
DEEPSEEK_MODEL=deepseek-v4-flash
