# DeepSeek API（https://platform.deepseek.com/ 申请）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenAI 兼容端点（默认官方地址，可换任何兼容代理）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek V4 系列模型（deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用）
# deepseek-v4-flash：快速便宜，适合日常对话与剧情生成（默认）
# deepseek-v4-pro：更强，适合关键节点与复杂剧情（更慢更贵）
DEEPSEEK_MODEL=deepseek-v4-flash

# 侧信道专属模型路由（C1/P1 + B3/Track B；空 = 回退 DEEPSEEK_MODEL）
# 混跑本地小模型（plan-local-14b §8.2）时按用途指定，如 DEEPSEEK_JUDGE_MODEL=local-14b
# DEEPSEEK_JUDGE_MODEL=
# DEEPSEEK_COMPRESS_MODEL=
# DEEPSEEK_EXTRACT_MODEL=
# DEEPSEEK_REFLECT_MODEL=
# DEEPSEEK_DEDUP_MODEL=

# 侧信道关闭思考模式（判官/去重等判定类调用；1 = 关）
# DEEPSEEK_DISABLE_THINKING=0

# LLM 调用 trace 落盘路径（B1/Track B；JSONL 事件流；留空 = 关闭）
# GAME_AGENT_TRACE=reports/trace.jsonl
