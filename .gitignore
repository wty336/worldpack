# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# 环境与密钥
.venv/
.env

# 测试与工具缓存
.pytest_cache/
.ruff_cache/
.coverage

# 产线工作日志（断点续跑用；体积≈数据集两倍，且可由它重生成）
data/**/.work/

# 人读清单的**全文附录**：等于把数据集复制一份（1000 条 ≈ 4.6 MB），
# 一条命令即可现场重生成（`python -m scripts.scenario_factory.factory_review`）；
# 清单主体（索引 + 标签总表 + 风险项）入库，那才是人读面。
reports/*-review-*-full.md

# 训练导出（④）的 jsonl：**纯派生数据**（34 MB，`export_training` 秒级零成本重生成，
# 且逐条校验过），不像 `data/route-a/*.jsonl` 那样要花 ¥96 才能重造 ⇒ 不入库；
# `manifest.json`（条数/摘要/种子/切分）入库 —— 它是这次导出的**回执**，
# 拿着它就能核对任何一次重生成（`dataset_sha256` 可比对）。
data/training/*.jsonl

# 训练产物（⑤）：adapter / 日志 / 指标 —— 机器产出、体积随实验增长，
# 人读小结（训练报告）另存 `reports/` 再入库。
runs/

# IDE
.idea/
.vscode/
